{"nodes": [{"id": "loopguard_docs_demo_script_demo_script", "label": "LoopGuard Demo Script", "file_type": "document", "source_file": "loopguard/docs/demo_script.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "loopguard_docs_demo_script_semantic_loop_detection", "label": "Semantic Loop Detection", "file_type": "concept", "source_file": "loopguard/docs/demo_script.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets the failure mode where an agent repeatedly calls the same tool with slightly different arguments (similarity 0.91 across the last 3 tool calls) \u2014 nothing crashes, but tokens burn every step; this silent cost is why the guard exists."}, {"id": "loopguard_docs_demo_script_guard_intervention_menu", "label": "Guard Intervention Menu", "file_type": "concept", "source_file": "loopguard/docs/demo_script.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the guard trips, the human chooses terminate, continue once, allowlist, or inject correction; injection lets the operator redirect the agent (e.g. from package.json to pyproject.toml) and recover the session instead of killing it."}, {"id": "loopguard_docs_demo_script_no_guard_mode", "label": "No-Guard Demo Mode", "file_type": "concept", "source_file": "loopguard/docs/demo_script.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately shows ten repeated read_file(...package.json...) attempts with rising cost to demonstrate the baseline pain before the guarded run."}], "edges": [{"source": "loopguard_docs_demo_script_demo_script", "target": "loopguard_docs_cerebras_setup_cerebras_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "loopguard/docs/demo_script.m