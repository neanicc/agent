{"nodes": [{"id": "docs_operations_billing_doc", "label": "Billing and Entitlement Safety", "file_type": "document", "source_file": "docs/operations/billing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_billing_stripe_webhook_verification", "label": "Stripe Webhook HMAC Verification", "file_type": "concept", "source_file": "docs/operations/billing.md", "source_location": "Stripe setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HMAC over the exact raw body with at most five minutes of clock skew, server-side tenant binding, and evt_ deduplication so forged, stale, malformed, unbound, or replayed webhooks fail closed. Provider creation time orders entitlement changes so an older event cannot roll back newer state."}, {"id": "docs_operations_billing_entitlement_states", "label": "Entitlement State Machine (active/grace/blocked/deleted)", "file_type": "concept", "source_file": "docs/operations/billing.md", "source_location": "Entitlement states", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payment failure or expired grace blocks only new hosted expensive work; local guarding, read, export, delete, and security paths are always available so billing state can never destroy evidence or interrupt local protection."}, {"id": "docs_operations_billing_immutable_price_catalog", "label": "Immutable Versioned Price Catalog", "file_type": "concept", "source_file": "docs/operations/billing.md", "source_location": "Prices, invoices, credits, and refunds", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each usage entry pins its catalog version so a mid-period price change produces separate invoice lines at old and new prices; USD lines use decimal arithmetic rounding half-up to cents, and binary floating point is forbidden."}, {"id": "docs_operations_billing_invoice_reconciliation", "label": "Invoice Reconciliation Against Usage Ledger", "file_type": "concept", "source_file": "docs/operations/billing.md", "source_location": "Prices, invoices, credits, and refunds", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invoices are rebuilt from the immutable usage ledger; a difference other than $0.00 blocks finalization, and credits/refunds/corrections are new signed, audited adjustment records rather than edits to existing lines."}], "edges": [{"source": "docs_operations_billing_doc", "target": "docs_operations_billing_stripe_webhook_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_billing_doc", "target": "docs_operations_billing_entitlement_states", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_billing_doc", "target": "docs_operations_billing_immutable_price_catalog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_billing_doc", "target": "docs_operations_billing_invoice_reconciliation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_billing_entitlement_states", "target": "docs_product_pricing_and_limits_local_guarding_independence", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_billing_invoice_reconciliation", "target": "docs_operations_metering_usage_ledger", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/billing.md", "source_location": null, "weight": 1.0}], "hyperedges": []}