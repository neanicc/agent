{"nodes": [{"id": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "label": "Regression Verification Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_proofcontract", "label": "ProofContract", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contract requires at least one acceptance criterion and one check; acceptance text auto-derived from a raw prompt stays a draft until a trusted rule or actor confirms it."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_commandrunner", "label": "Bounded CommandRunner", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never shell=True, empty environment plus allowlist, network denied by default, resource and output limits, and an honest unsandboxed label when the platform cannot provide a real isolation boundary."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_baselineservice", "label": "BaselineService", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capturing pre-existing failures before the first mutation is what allows new failures to be distinguished from old ones instead of blaming the agent for inherited breakage."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_impactanalyzer", "label": "ImpactAnalyzer", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every selected test must carry an explanation edge; a missing or stale index falls back to the conservative trusted full suite and never guesses a smaller one."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_verificationverdict", "label": "VerificationVerdict", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set-based comparison of baseline versus current failure IDs deterministically separates regression from verified_with_preexisting_failures; any required timeout, skip, or parser error prevents verified."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_verificationservice", "label": "Immutable VerificationService and Evidence Store", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Completed verifications are immutable; evidence is content-addressed, encrypted, and bound by a signed manifest because mutable paths and database hashes without stored bytes are not evidence."}, {"id": "docs_superpowers_plans_2026_07_02_regression_verification_proof_ownership_rule", "label": "Proof Ownership Rule", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": "Preamble", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A result is called verified only when task intake, proof contract, clean pre-mutation snapshot, and required baseline were recorded before the first mutating tool; unproven ordering yields inconclusive or checks-passed-unbaselined, never verified."}], "edges": [{"source": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "target": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_regression_verification", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "target": "docs_superpowers_plans_2026_07_02_regression_verification_proofcontract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "target": "docs_superpowers_plans_2026_07_02_regression_verification_commandrunner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "target": "docs_superpowers_plans_2026_07_02_regression_verification_baselineservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_regression_verification_plan", "target": "docs_superpowers_plans_2026_07_02_regression_verification_impactanalyzer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-regression-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_p