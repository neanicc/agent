{"nodes": [{"id": "docs_superpowers_plans_2026_07_02_browser_acceleration_plan", "label": "Browser and Playwright Acceleration Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-02-browser-acceleration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_02_browser_acceleration_browser_broker", "label": "Warm Browser Broker", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-browser-acceleration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A version-pinned Node broker keeps browser server processes warm to cut startup latency; a standalone page.run API does not count as Playwright-test acceleration."}, {"id": "docs_superpowers_plans_2026_07_02_browser_acceleration_broker_protocol", "label": "Bounded Framed Broker Protocol", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-browser-acceleration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zod-validated discriminated commands over bounded length-prefixed frames; unknown fields/versions rejected, context capability IDs unguessable and session-bound, no cookies or page HTML in logs."}, {"id": "docs_superpowers_plans_2026_07_02_browser_acceleration_context_isolation", "label": "Per-Session BrowserContext Isolation", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-browser-acceleration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser process is reused but context storage never is; each worker/session gets a fresh isolated BrowserContext and closing a session destroys every page and context."}], "edges": [{"source": "docs_superpowers_plans_2026_07_02_browser_acceleration_plan", "target": "docs_su