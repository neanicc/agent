{"nodes": [{"id": "docs_reference_cloud_retention_retention_by_data_class", "label": "Retention by Data Class", "file_type": "concept", "source_file": "docs/reference/cloud-retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retention applies per data class rather than by blanket table purge so legal/contractual holds can override ordinary expiry without destroying audit or billing evidence."}, {"id": "docs_reference_cloud_retention_append_only_audit", "label": "Append-Only Audit Ledger", "file_type": "concept", "source_file": "docs/reference/cloud-retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ordinary application role cannot update or delete audit rows; PostgreSQL enforces this with revoked privileges and a mutation-rejecting trigger, and the ORM fails before flush."}, {"id": "docs_reference_cloud_retention_crypto_shredding", "label": "Crypto-Shredding of Artifact Keys", "file_type": "concept", "source_file": "docs/reference/cloud-retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reference_cloud_retention_privileged_retention_workflow", "label": "Privileged Retention Workflow", "file_type": "concept", "source_file": "docs/reference/cloud-retention.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only a separate human-authorized workflow may de-identify allowed fields or crypto-shred keys, and it must append a tombstone describing its authority; it never makes retained audit identity look like an active user."}, {"id": "docs_reference_cloud_retention_temporal_workflow_ids", "label": "Domain-Derived Temporal Workflow IDs", "file_type": "concept", "source_file": "docs/reference/cloud-retention.md", "source_location": null, "source_url": null, "captu