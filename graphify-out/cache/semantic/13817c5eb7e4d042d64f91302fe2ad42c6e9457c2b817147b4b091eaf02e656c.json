{"nodes": [{"id": "docs_superpowers_plans_2026_07_02_production_hardening_plan", "label": "Production Security and Operations Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_02_production_hardening_threat_model", "label": "Production Threat Model", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical abuse paths are encoded as failing tests first; every critical/high abuse path must link to a test, owner, and mitigation, and controls missing from earlier owning plans are moved back into those plans."}, {"id": "docs_superpowers_plans_2026_07_02_production_hardening_release_provenance", "label": "Signed Release Provenance", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every release artifact requires checksum, SBOM, provenance attestation, and Sigstore signature; provider credentials are never available to jobs that execute untrusted repository code, and ordinary PRs build/verify but never publish."}, {"id": "docs_superpowers_plans_2026_07_02_production_hardening_metering_billing", "label": "Metering, Billing Reconciliation, and Quota Safety", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": "Task 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Billing failure never disables local guarding or deletes evidence; usage is an append-only idempotent ledger that invoices must reconcile to, and quota exhaustion never terminates local protection."}, {"id": "docs_superpowers_plans_2026_07_02_production_hardening_repair_worker_isolation", "label": "Repair Worker Sandbox Isolation", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": "Task 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repair workers execute untrusted repository code, so they get a dedicated node pool/namespace/service account, deny-all NetworkPolicy, no cloud metadata or service-account token, no hostPath or container socket, and a gVisor RuntimeClass or isolated microVM backend."}], "edges": [{"source": "docs_superpowers_plans_2026_07_02_production_hardening_plan", "target": "docs_superpowers_plans_2026_07_02_production_hardening_threat_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_production_hardening_plan", "target": "docs_superpowers_plans_2026_07_02_production_hardening_release_provenance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_production_hardening_plan", "target": "docs_superpowers_plans_2026_07_02_production_hardening_metering_billing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-02-production-hardening.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_02_production_hardening_plan", "target": "docs_superpowers_plans_2026_07_02_production_hardening_repair_worker_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fil