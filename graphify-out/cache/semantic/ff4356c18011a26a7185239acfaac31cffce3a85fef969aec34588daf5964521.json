{"nodes": [{"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "label": "LoopGuard v2 From Showcase to Real Product Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer1_detectors", "label": "Layer 1 Deterministic Detectors", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept always-on because they are deterministic, free, and offline; they are the cheap tripwire that flags suspected loops and the only requirement for offline mode."}, {"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer2_llm_judge", "label": "Layer 2 LLM Judge", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The judge calls the provider directly, never through guard.observe(), so judging cannot trip the guard on itself; on provider failure it falls back to Layer 1's decision (fail-safe, never silently fail-open), and its own token cost is tracked as a judge meta-cost."}, {"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_llmprovider_protocol", "label": "LLMProvider Protocol", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin protocol decouples the judge and live agent from any specific vendor; LiteLLMProvider gives one code path to every provider including local models, with a direct CerebrasProvider for minimal-deps runs."}, {"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_pricing_model", "label": "Real Cost Pricing Model", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost comes from real token usage and known prices; an unknown model yields 0.0 plus a one-time warning rather than an invented number, and offline runs are honestly $0.00."}, {"id": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_action_modes", "label": "Action Modes pause/flag/auto", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision and response are deliberately decoupled: what to do about a confirmed loop is a policy, and UI/transport stays out of the core so the same engine can be wrapped by dashboards and the future cloud app."}], "edges": [{"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer1_detectors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer2_llm_judge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_llmprovider_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_pricing_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_spec", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_action_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer2_llm_judge", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_llmprovider_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer2_llm_judge", "target": "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_pricing_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md", "source_location": "Section 2", "weight": 1.0}], "hyperedges": [{"id": "two_layer_loop_handling_flow", "label": "Two-Layer Loop Handling Flow: Detect, Judge, Act", "nodes": ["docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer1_detectors", "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_layer2_llm_judge", "docs_superpowers_specs_2026_06_27_loopguard_v2_real_product_design_action_modes"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-27-loopguard-v2-real-product-design.md"}]}