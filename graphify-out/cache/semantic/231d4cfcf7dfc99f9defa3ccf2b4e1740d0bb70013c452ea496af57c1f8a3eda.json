{"nodes": [{"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_spec", "label": "LoopGuard Reliability Control Plane Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_controlevent", "label": "ControlEvent Envelope", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Stable core and new boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduced so the product layer does not turn LoopEvent into a universal event object; adapters project relevant ControlEvent payloads into existing LoopEvents, keeping the loop detector small while other subsystems evolve independently."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_loopguardd_daemon", "label": "loopguardd Local Daemon", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Local daemon", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trusted local coordinator: Unix socket/named pipe, SQLite WAL, redaction before persistence or relay, outbound-only cloud connection, and continued useful local operation when the cloud is unavailable."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_agentadapter_protocol", "label": "AgentAdapter Protocol", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Agent integrations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capabilities are negotiated per surface; unsupported operations return a typed CapabilityUnavailable result rather than silently doing nothing, and no adapter substitutes one lifecycle operation for another."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_actionrequest_signing", "label": "Signed ActionRequest Flow", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Hosted control plane", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The phone never connects directly to the daemon; a device-signed expiring request countersigned by a rotating cloud key lets the daemon verify user, device, tenant, target, nonce, expiry, capability, and state version before acting, and API 202 acceptance is never displayed as execution success."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_change_journal", "label": "Change Journal", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Shared context and coordination", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records file hashes, patches, symbols, actor, and a monotonic repository cursor so concurrent agents coordinate through compact verified context instead of copied transcripts or hidden reasoning."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_regression_verification", "label": "Regression Verification Subsystem", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Regression verification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proof Core ships before the full context index because trusted discovery, pre-mutation baseline, conservative fallback, deterministic verdict, and immutable evidence are independently useful; a missing or stale index can never weaken the final gate."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_model_effort_router", "label": "Deterministic Model and Effort Router", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Model and effort routing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The initial router is deterministic policy, not an LLM: it never selects a model unavailable on the current surface, records considered candidates and reasons, and online learning is explicitly excluded from the first release."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_preference_engine", "label": "Layered Preference Engine", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Preference engine", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Safety rules, repository conventions, explicit user preferences, then learned soft preferences; deterministic rules run first and a subjective violation stays a warning unless the user promotes it to blocking."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_browser_broker", "label": "Browser Broker", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Browser broker", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warm Playwright processes with a fresh isolated BrowserContext per run; iteration uses impacted smoke tests while merge gates stay comprehensive, and speed claims compare against native Playwright worker reuse."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_auto_healing_pipelines", "label": "Auto-Healing Pipelines", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Auto-healing pipelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repairs reproduce failures in isolated sandboxes at immutable revisions, generate independent candidates, and open evidence-rich draft PRs; workers get no production write credentials and the first release never deploys or merges a repair automatically."}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_hosted_control_plane", "label": "Hosted Control Plane", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Hosted control plane", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_cursor_domains", "label": "Independent Cursor Domains", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-02-loopguard-reliability-control-plane-design.md", "source_location": "Stable core and new boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "local_log_seq, repo_seq, session_seq, cloud_ingest_seq, and client_stream_seq are deliberately non-interchangeable orders; every field and API uses its full domain name to prevent cursor confusion across host, repository, session, ingest, and delivery."}], "edges": [{"source": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_spec", "target": "docs_superpowers_specs_2026_07_02_loopguard_reliability_control_plane_design_controlevent", "relation": "references", "