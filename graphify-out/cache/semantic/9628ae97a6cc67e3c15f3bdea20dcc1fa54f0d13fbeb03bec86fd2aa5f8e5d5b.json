{"nodes": [{"id": "docs_operations_release_process_doc", "label": "Secure Release Process", "file_type": "document", "source_file": "docs/operations/release-process.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_operations_release_process_release_manifest", "label": "Release Manifest (artifacts/release/manifest.json)", "file_type": "concept", "source_file": "docs/operations/release-process.md", "source_location": "What a release contains", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binds every output (wheel, npm tarball, OCI images, iOS archive) to the exact build commit, SHA-256, SPDX/CycloneDX SBOM, SLSA/in-toto provenance, and Sigstore bundle; images use immutable digests, never mutable tags, and paths may not escape the release directory."}, {"id": "docs_operations_release_process_ci_trust_boundaries", "label": "CI Trust Boundaries", "file_type": "concept", "source_file": "docs/operations/release-process.md", "source_location": "CI trust boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actions are pinned to immutable commit SHAs, permissions start read-only, untrusted PR code never runs in pull_request_target or receives secrets, and outputs move between jobs only through checksummed artifacts so a compromised PR cannot reach signing credentials."}, {"id": "docs_operations_release_process_release_verification", "label": "verify_release.sh Cosign Verification", "file_type": "concept", "source_file": "docs/operations/release-process.md", "source_location": "What a release contains", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks every checksum and evidence binding, then runs cosign verify-blob/verify with the manifest's exact GitHub workflow identity and OIDC issuer; any missing tool, mismatched commit, wrong digest, symlink, traversal, or failed signature fails the entire release and lists all defects."}], "edges": [{"source": "docs_operations_release_process_doc", "target": "docs_operations_release_process_release_manifest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/release-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_release_process_doc", "target": "docs_operations_release_process_ci_trust_boundaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/release-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_release_process_doc", "target": "docs_operations_release_process_release_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/release-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_release_process_doc", "target": "docs_reference_cli_quickstart", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/operations/release-process.md", "source_location": null, "weight": 1.0}, {"source": "docs_operations_release_process_release_verification", "target": "docs_operations_client_release_keyless_cosign_signing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/operations/release-process.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "signed_immutable_digest_supply_chain", "label": "Signed Immutable-Digest Supply Chain", "nodes": ["docs_operations_release_process_release_manifest", "docs_operations_release_process_release_verification", "docs_operations_client_release_keyless_cosign_signing", "docs_operations_deployment_deploy_workflow"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/operations/release-process.md"}]}