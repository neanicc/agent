{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook SessionStart",
            "commandWindows": "loopguard hook-entry codex SessionStart --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook UserPromptSubmit",
            "commandWindows": "loopguard hook-entry codex UserPromptSubmit --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook PreToolUse",
            "commandWindows": "loopguard hook-entry codex PreToolUse --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: PreToolUse"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook PermissionRequest",
            "commandWindows": "loopguard hook-entry codex PermissionRequest --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: PermissionRequest"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook PostToolUse",
            "commandWindows": "loopguard hook-entry codex PostToolUse --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: PostToolUse"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook PreCompact",
            "commandWindows": "loopguard hook-entry codex PreCompact --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: PreCompact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/bin/loopguard-hook Stop",
            "commandWindows": "loopguard hook-entry codex Stop --integration-version 1",
            "timeout": 1,
            "statusMessage": "LoopGuard: Stop"
          }
        ]
      }
    ]
  }
}
