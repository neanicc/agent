{
  "components": {
    "schemas": {
      "ActionChallengeRequest": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "expected_state_hash": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Expected State Hash",
            "type": "string"
          },
          "expected_state_version": {
            "minimum": 0.0,
            "title": "Expected State Version",
            "type": "integer"
          },
          "expires_in": {
            "default": 30,
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Expires In",
            "type": "integer"
          },
          "kind": {
            "enum": [
              "interrupt",
              "approve",
              "continue_once",
              "inject",
              "publish_repair"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "target": {
            "$ref": "#/components/schemas/ActionTargetRequest"
          }
        },
        "required": [
          "target",
          "device_id",
          "kind",
          "expected_state_version",
          "expected_state_hash"
        ],
        "title": "ActionChallengeRequest",
        "type": "object"
      },
      "ActionTargetRequest": {
        "additionalProperties": false,
        "properties": {
          "host_id": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Host Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "session",
              "repair",
              "host",
              "verification",
              "repository"
            ],
            "title": "Kind",
            "type": "string"
          },
          "target_id": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target_id",
          "host_id"
        ],
        "title": "ActionTargetRequest",
        "type": "object"
      },
      "ArtifactCompletion": {
        "additionalProperties": false,
        "properties": {
          "evidence_manifest": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Evidence Manifest",
            "type": "string"
          }
        },
        "required": [
          "evidence_manifest"
        ],
        "title": "ArtifactCompletion",
        "type": "object"
      },
      "ArtifactInitiation": {
        "additionalProperties": false,
        "properties": {
          "byte_count": {
            "maximum": 5368709120.0,
            "minimum": 1.0,
            "title": "Byte Count",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "media_type": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "retention_class": {
            "enum": [
              "source",
              "log",
              "proof",
              "repair"
            ],
            "title": "Retention Class",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "sha256",
          "byte_count",
          "media_type",
          "retention_class"
        ],
        "title": "ArtifactInitiation",
        "type": "object"
      },
      "DevicePairingCompletion": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "pairing_id": {
            "maxLength": 256,
            "minLength": 16,
            "title": "Pairing Id",
            "type": "string"
          },
          "public_key": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Public Key",
            "type": "string"
          },
          "public_key_alg": {
            "enum": [
              "Ed25519",
              "P-256"
            ],
            "title": "Public Key Alg",
            "type": "string"
          },
          "signature": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Signature",
            "type": "string"
          }
        },
        "required": [
          "pairing_id",
          "public_key_alg",
          "public_key",
          "signature",
          "name"
        ],
        "title": "DevicePairingCompletion",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HostPairingRequest": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "title": "Algorithm",
            "type": "string"
          },
          "code": {
            "maxLength": 256,
            "minLength": 20,
            "title": "Code",
            "type": "string"
          },
          "name": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "public_key": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Public Key",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "public_key",
          "algorithm"
        ],
        "title": "HostPairingRequest",
        "type": "object"
      },
      "PairingCodeResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "code",
          "expires_at"
        ],
        "title": "PairingCodeResponse",
        "type": "object"
      },
      "PreferenceUpdate": {
        "additionalProperties": false,
        "properties": {
          "rules": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 500,
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "PreferenceUpdate",
        "type": "object"
      },
      "PublicBuild": {
        "additionalProperties": false,
        "properties": {
          "build_sha": {
            "title": "Build Sha",
            "type": "string"
          },
          "environment": {
            "enum": [
              "development",
              "test",
              "staging",
              "production"
            ],
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "const": "loopguard-control-api",
            "default": "loopguard-control-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "build_sha",
          "environment"
        ],
        "title": "PublicBuild",
        "type": "object"
      },
      "SignedActionAcceptance": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Action Id",
            "type": "string"
          },
          "device_algorithm": {
            "const": "Ed25519",
            "title": "Device Algorithm",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "device_key_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Device Key Id",
            "type": "string"
          },
          "device_signature": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Device Signature",
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "device_id",
          "device_key_id",
          "device_algorithm",
          "device_signature"
        ],
        "title": "SignedActionAcceptance",
        "type": "object"
      },
      "StreamTicketRequest": {
        "additionalProperties": false,
        "properties": {
          "after_session_seq": {
            "default": 0,
            "minimum": 0.0,
            "title": "After Session Seq",
            "type": "integer"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "StreamTicketRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
